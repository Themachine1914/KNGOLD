# Copiar a .env y completar valores reales (nunca subir .env a GitHub)

DATABASE_URL="file:./dev.db"
AUTH_SECRET="cambia-este-secreto-largo"
AUTH_URL="http://localhost:3000"
RESERVATION_HOURS="48"

# Secreto propio del cron que expira las reservas de 48h.
# Sin esto, GET /api/cron/expire-quotes responde 503 y las reservas no vencen.
# Generar con: openssl rand -base64 32
CRON_SECRET=""

# Clave inicial de las cuentas que crea `npm run db:seed`.
# Obligatoria: el seed falla si no está. Mínimo 8 caracteres.
SEED_OWNER_PASSWORD=""

# Para producción en Vercel (después):
# AUTH_URL="https://tu-dominio.vercel.app"
# DATABASE_URL=  → SQLite local no sirve en Vercel; usar Postgres (Neon/Supabase)
# Vercel manda solo la cabecera Authorization: Bearer $CRON_SECRET a los crons
# definidos en vercel.json, así que basta con configurar la variable allí.
