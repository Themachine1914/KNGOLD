# Auth
AUTH_SECRET="genera-un-secreto-largo"
# El dominio EXACTO donde corre la app, sin barra final. En producción debe
# ser https://tu-dominio, no localhost: next-auth reconstruye la petición con
# este origen y los redirects salen hacia aquí.
AUTH_URL="http://localhost:3000"
RESERVATION_HOURS="48"

# Secreto del cron que expira las reservas de 48h. OBLIGATORIO:
# sin él, /api/cron/expire-quotes responde 503 y las reservas no vencen solas.
# Generar con: openssl rand -base64 32
CRON_SECRET=""

# Clave inicial de las cuentas que crea `npm run db:seed`. OBLIGATORIA:
# el seed falla si falta. Mínimo 8 caracteres.
SEED_OWNER_PASSWORD=""

# Firebase (Firestore) — Service Account
# Opción A: JSON completo en una sola línea
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}'

# Opción B: campos separados
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Web Push (avisos con la app cerrada). Generar con:
#   npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@kngold.com.do"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
