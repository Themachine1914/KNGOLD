# Auth
AUTH_SECRET="genera-un-secreto-largo"
AUTH_URL="http://localhost:3000"
RESERVATION_HOURS="48"

# Firebase (Firestore) — Service Account
# Opción A: JSON completo en una sola línea
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}'

# Opción B: campos separados
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
