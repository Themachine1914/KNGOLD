rules_version = '2';

// La app entra a Firestore SOLO desde el servidor, con el SDK de administrador
// (src/lib/firebase.ts), y ese SDK se salta estas reglas. Ningún cliente debe
// tocar la base directamente.
//
// Si la base se creó en "modo de prueba", quedó abierta a cualquiera que
// conozca el projectId: podría leer precios, clientes y cotizaciones, o
// escribir stock. Esto la cierra.
//
// Desplegar con:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
